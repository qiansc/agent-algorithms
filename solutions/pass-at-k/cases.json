    {"name": "一条都没成功", "args": [5, 0, 3], "expected": 0.0},
    {"name": "最小输入", "args": [1, 1, 1], "expected": 1.0},
    {"name": "最小输入，失败", "args": [1, 0, 1], "expected": 0.0},
    {"name": "全部成功", "args": [5, 5, 1], "expected": 1.0},
    {"name": "失败记录正好 k 条", "args": [5, 2, 3], "expected": 0.9},
