{
  "python": "allow_requests",
  "typescript": "allowRequests",
  "kind": "function",
  "cases": [
    { "name": "样例：第 60 秒时第 0 秒的两次恰好离开窗口", "args": [[0, 0, 59, 59, 60, 60, 60], 60, 3], "expected": [true, true, true, false, true, true, false] },
    { "name": "空输入", "args": [[], 60, 3], "expected": [] },
    { "name": "同一秒来了四次", "args": [[10, 10, 10, 10], 60, 3], "expected": [true, true, true, false] },
    { "name": "limit = 0 全部拒绝", "args": [[1, 2, 3], 5, 0], "expected": [false, false, false] },
    { "name": "w = 1 时同一秒只放一次", "args": [[5, 5, 5, 6], 1, 1], "expected": [true, false, false, true] },
    { "name": "被拒绝的请求不占名额", "args": [[0, 1, 2, 3, 4], 3, 1], "expected": [true, false, false, true, false] },
    { "name": "间隔正好等于 w", "args": [[0, 60, 120], 60, 1], "expected": [true, true, true] },
    { "name": "间隔比 w 少 1", "args": [[0, 59, 60], 60, 1], "expected": [true, false, true] },
    { "name": "30 次随机请求（与逐个数窗口的写法对拍）", "args": [[5, 10, 14, 15, 29, 36, 45, 47, 50, 52, 52, 56, 60, 62, 62, 65, 67, 73, 75, 83, 83, 87, 98, 103, 104, 104, 111, 114, 116, 119], 20, 4], "expected": [true, true, true, true, true, true, true, true, true, false, false, true, false, false, false, true, true, true, false, true, false, true, true, true, true, false, true, false, false, true] },
    { "name": "非法：w = 0", "args": [[1], 0, 3], "raises": true },
    { "name": "非法：limit 为负", "args": [[1], 60, -1], "raises": true },
    { "name": "非法：时间倒序", "args": [[5, 3], 60, 3], "raises": true }
  ]
}
