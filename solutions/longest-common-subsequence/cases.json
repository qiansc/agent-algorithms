{
  "python": "lcs",
  "typescript": "lcs",
  "kind": "function",
  "cases": [
    { "name": "样例 1：长度 4，回溯得到 BCBA", "args": ["ABCBDAB", "BDCABA"], "expected": [4, ["B", "C", "B", "A"]] },
    { "name": "样例 2：工具调用轨迹（列表）", "args": [["搜索", "打开", "点击", "搜索", "提交"], ["搜索", "点击", "打开", "提交"]], "expected": [3, ["搜索", "打开", "提交"]] },
    { "name": "两边都为空", "args": ["", ""], "expected": [0, []] },
    { "name": "一边为空", "args": ["abc", ""], "expected": [0, []] },
    { "name": "没有公共元素", "args": ["abc", "def"], "expected": [0, []] },
    { "name": "不连续也算（不是公共子串）", "args": ["abcde", "ace"], "expected": [3, ["a", "c", "e"]] },
    { "name": "重复字符", "args": ["aaa", "aa"], "expected": [2, ["a", "a"]] },
    { "name": "交换参数顺序，长度相同，序列可以不同", "args": ["BDCABA", "ABCBDAB"], "expected": [4, ["B", "D", "A", "B"]] },
    { "name": "整数列表", "args": [[1, 2, 3, 2, 1], [3, 2, 1, 2, 3]], "expected": [3, [1, 2, 3]] },
    { "name": "中文", "args": ["查天气查路况", "查路况天气"], "expected": [3, ["查", "天", "气"]] },
    { "name": "emoji 按一个字符算", "args": ["a😀b", "😀b"], "expected": [2, ["😀", "b"]] },
    {
      "name": "随机 DNA 片段 30 × 25",
      "args": ["ATGTCAGAGGCACACTACTCCACCTCTCAC", "CCCCTGAAGAAATTGTGCTTACCGT"],
      "expected": [14, ["T", "G", "A", "G", "A", "G", "G", "C", "T", "T", "A", "C", "C", "T"]]
    }
  ]
}
