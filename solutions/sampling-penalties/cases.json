{
  "python": "next_token_probs",
  "typescript": "nextTokenProbs",
  "kind": "function",
  "tol": 1e-9,
  "cases": [
    { "name": "样例 1：三个 2.0 并列，Top-2 全部保留", "args": [[2.0, -1.0, 0.5, 1.0, 1.0], [0, 1, 1], 2.0, 0.5, 2], "expected": [0.3333333333333333, 0.0, 0.0, 0.3333333333333333, 0.3333333333333333] },
    { "name": "样例 2：负分要乘以 penalty", "args": [[1.0, -1.0], [1], 2.0, 1.0, 2], "expected": [0.9525741268224334, 0.04742587317756679] },
    { "name": "样例 3：先惩罚再 Top-k", "args": [[3.0, 2.0, 1.0], [0], 4.0, 1.0, 2], "expected": [0.0, 0.7310585786300049, 0.2689414213699951] },
    { "name": "分数为 0 时乘以 penalty 仍是 0，并列保留", "args": [[0.0, 0.0, -2.0], [0, 2], 3.0, 1.0, 1], "expected": [0.5, 0.5, 0.0] },
    { "name": "最小输入：只有一个 token", "args": [[1.5], [0, 0], 2.0, 0.7, 1], "expected": [1.0] },
    { "name": "k 大于词表、没有历史：只做温度", "args": [[1.0, 2.0, 3.0], [], 1.0, 2.0, 10], "expected": [0.1863237232258476, 0.3071958857184984, 0.506480391055654] },
    { "name": "10 个 token 的随机数据", "args": [[-2.77, 1.18, -2.14, -0.22, 1.03, 1.76, -0.28, -0.01, -2.89, -0.41], [5, 9, 8, 6, 6, 2], 1.3, 0.8, 4], "expected": [0.0, 0.3032423584899363, 0.0, 0.0, 0.25139674505385673, 0.376847290763765, 0.0, 0.06851360569244212, 0.0, 0.0] },
    { "name": "很大的分数也不溢出", "args": [[1000.0, 999.0, -1000.0], [], 1.0, 1.0, 2], "expected": [0.7310585786300049, 0.2689414213699951, 0.0] },
    { "name": "空 logits", "args": [[], [], 1.0, 1.0, 1], "raises": true },
    { "name": "temperature = 0", "args": [[1.0, 2.0], [], 1.0, 0, 1], "raises": true },
    { "name": "k = 0", "args": [[1.0, 2.0], [], 1.0, 1.0, 0], "raises": true },
    { "name": "历史里的编号越界", "args": [[1.0, 2.0], [2], 1.0, 1.0, 1], "raises": true }
