---
// 同一道题的 Python 与 TypeScript 解法。代码直接读取 solutions/<slug>/ 下的文件，
// 与测试用的是同一份源码。语言选择在全站同步，并记在浏览器里。
import { Tabs, TabItem, Code } from '@astrojs/starlight/components';

interface Props {
  slug: string;
  file?: string;
  title?: string;
}

const { slug, file = 'solution', title } = Astro.props;
const pyFiles = import.meta.glob('/solutions/*/*.py', { query: '?raw', import: 'default', eager: true });
const tsFiles = import.meta.glob('/solutions/*/*.ts', { query: '?raw', import: 'default', eager: true });
const py = pyFiles[`/solutions/${slug}/${file}.py`] as string | undefined;
const ts = tsFiles[`/solutions/${slug}/${file}.ts`] as string | undefined;
if (!py || !ts) {
  throw new Error(`missing solutions/${slug}/${file}.py or .ts`);
}
---

<Tabs syncKey="lang">
  <TabItem label="Python">
    <Code code={py.trimEnd()} lang="python" title={title ? `${title}.py` : undefined} />
  </TabItem>
  <TabItem label="TypeScript">
    <Code code={ts.trimEnd()} lang="ts" title={title ? `${title}.ts` : undefined} />
  </TabItem>
</Tabs>
