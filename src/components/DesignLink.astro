---
import { designs } from '../data/problems';

interface Props {
  slug: string;
  label?: string;
}

const d = designs.find((x) => x.slug === Astro.props.slug);
if (!d) throw new Error(`unknown design page: ${Astro.props.slug}`);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a href={`${base}/design/${d.slug}/`}>{Astro.props.label ?? `「${d.title}」`}</a>
