---
// 首页的一天：标题、主题、总时长，下面每行一道题或一篇设计练习。
import { designs, getProblem, problemPath, type StudyDay } from '../data/problems';

interface Props {
  day: StudyDay;
  index: number;
}

const { day, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const level = { 简单: 'easy', 中等: 'medium', 困难: 'hard' } as const;

const rows = day.items.map((id) => {
  if (id.startsWith('design:')) {
    const d = designs.find((x) => `design:${x.slug}` === id);
    if (!d) throw new Error(`unknown design page: ${id}`);
    return { id: `design/${d.slug}`, tag: `设计 ${designs.indexOf(d) + 1}`, title: d.title, href: `${base}/design/${d.slug}/`, minutes: 30, level: null };
  }
  const p = getProblem(id);
  return { id: `problems/${p.group}/${p.slug}`, tag: String(p.number), title: p.title, href: problemPath(p.slug), minutes: p.minutes, level: p.difficulty };
});
const total = rows.reduce((s, r) => s + r.minutes, 0);
const hours = Math.round((total / 60) * 2) / 2;
const count = rows.filter((r) => r.level).length;
const designCount = rows.length - count;
---

<section class="plan-day not-content">
  <header>
    <span class="plan-day-index">{index}</span>
    <div class="plan-day-head">
      <h2 id={`day-${index}`}>{day.title}</h2>
      <p>{day.theme}</p>
    </div>
    <p class="plan-day-total">
      {count} 题{designCount > 0 && ` + ${designCount} 篇设计`}<br />约 {hours} 小时
    </p>
  </header>
  <ol>
    {rows.map((r) => (
      <li>
        <a href={r.href} data-done-id={r.id}>
          <span class="plan-tag">{r.tag}</span>
          <span class="plan-title">{r.title}<span class="done-icon plan-done" aria-label="已完成"></span></span>
          {r.level ? (
            <span class={`sl-badge difficulty difficulty-${level[r.level]}`}>{r.level}</span>
          ) : (
            <span class="sl-badge difficulty plan-read">阅读</span>
          )}
          <span class="plan-min">{r.minutes} 分钟</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .plan-day {
    margin: 1.6rem 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    overflow: hidden;
  }
  header {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem;
    background: var(--sl-color-gray-6);
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .plan-day-index {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .plan-day-head {
    flex: 1;
    min-width: 0;
  }
  .plan-day-head h2 {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .plan-day-head p {
    margin: 0.1rem 0 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  .plan-day-total {
    margin: 0;
    text-align: end;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0.35rem 0;
  }
  li + li {
    border-top: 1px solid var(--sl-color-gray-6);
  }
  li a {
    display: grid;
    grid-template-columns: 3.6rem 1fr auto 4.2rem;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.1rem;
    color: var(--sl-color-gray-1);
    text-decoration: none;
  }
  li a:hover {
    background: var(--sl-color-gray-6);
  }
  li a:hover .plan-title {
    color: var(--sl-color-accent);
  }
  .plan-tag {
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }
  .plan-title {
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .plan-min {
    text-align: end;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
  .sl-badge.difficulty {
    margin: 0;
  }
  .plan-done {
    display: none;
    margin-inline-start: 0.45rem;
    vertical-align: -0.15em;
    color: var(--done-color);
  }
  .plan-read {
    color: var(--sl-color-gray-3);
  }
  @media (max-width: 40rem) {
    li a {
      grid-template-columns: 2.6rem 1fr auto;
    }
    .plan-min {
      display: none;
    }
  }
</style>
