---
// RoPE 专用图：把向量的每一对 (x, y) 画在一个小平面上，显示旋转后的位置。
// 角度按 θ = pos × base^(−2j/d) 计算，与 solutions/rope 的代码一致。
// trail 里的位置画成淡色的点，便于看出每前进一个位置转了多少。
import { uid } from '../../viz/shared';

interface Wrong {
  pair: number;
  x: number;
  y: number;
  label: string;
}
interface Props {
  vec: number[];
  pos: number;
  base: number;
  trail?: number[];
  wrong?: Wrong;
}

const { vec, pos, base, trail = [], wrong } = Astro.props;
const d = vec.length;
const pairs = d / 2;
const R = 72; // 单位长度对应的像素
const W = 250; // 每个平面的宽度
const cx = W / 2;
const cy = 40 + R + 16;
const H = cy + R + 58;
const id = uid('rope'); // 每张图自己的箭头 id，避免和隐藏帧里的同名 marker 冲突
const scale = Math.max(1, ...Array.from({ length: pairs }, (_, j) => Math.hypot(vec[2 * j], vec[2 * j + 1])));
const fmt = (v: number) => (Math.abs(v) < 5e-5 ? 0 : v).toFixed(3); // 避免出现 -0.000

function rotate(j: number, p: number) {
  const theta = p * base ** ((-2 * j) / d);
  const x = vec[2 * j];
  const y = vec[2 * j + 1];
  return { theta, x: x * Math.cos(theta) - y * Math.sin(theta), y: x * Math.sin(theta) + y * Math.cos(theta) };
}
const px = (x: number) => cx + (R * x) / scale;
const py = (y: number) => cy - (R * y) / scale;

const planes = Array.from({ length: pairs }, (_, j) => {
  const cur = rotate(j, pos);
  const freq = base ** ((-2 * j) / d);
  const ar = 24;
  const t = cur.theta;
  const large = ((t % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI) > Math.PI ? 1 : 0;
  const arc = Math.abs(t) > 1e-9
    ? `M ${cx + ar} ${cy} A ${ar} ${ar} 0 ${large} ${t > 0 ? 0 : 1} ${cx + ar * Math.cos(t)} ${cy - ar * Math.sin(t)}`
    : '';
  return {
    j,
    freq,
    cur,
    arc,
    // 点挨得太近时只给第一个点标位置号，免得数字叠在一起
    trail: trail.map((p) => ({ p, ...rotate(j, p) })).map((tp, k, all) => ({
      ...tp,
      showLabel: all.slice(0, k).every((o) => Math.hypot(px(o.x) - px(tp.x), py(o.y) - py(tp.y)) > 16),
    })),
  };
});
const width = pairs * W;
---

<svg class="viz rope-planes" viewBox={`0 0 ${width} ${H}`} width={width} height={H} role="img" aria-label={`位置 ${pos} 时每一对维度的旋转`}>
  <defs>
    <marker id={`${id}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="rope-head" d="M 0 0 L 10 5 L 0 10 z" />
    </marker>
    <marker id={`${id}-w`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="rope-head-warn" d="M 0 0 L 10 5 L 0 10 z" />
    </marker>
  </defs>
  {planes.map((pl) => (
    <g transform={`translate(${pl.j * W} 0)`}>
      <text class="viz-header" x={cx} y={14} text-anchor="middle">第 {pl.j} 对：维 {2 * pl.j}、{2 * pl.j + 1}</text>
      <text class="viz-index" x={cx} y={31} text-anchor="middle">每个位置转 {Number(pl.freq.toFixed(4))} 弧度</text>
      <line class="viz-axis" x1={cx - R - 14} x2={cx + R + 14} y1={cy} y2={cy} />
      <line class="viz-axis" x1={cx} x2={cx} y1={cy - R - 10} y2={cy + R + 10} />
      <circle class="rope-circle" cx={cx} cy={cy} r={R} />
      {pl.arc && <path class="rope-arc" d={pl.arc} />}
      {pl.trail.map((tp) => (
        <g class="rope-trail">
          <circle cx={px(tp.x)} cy={py(tp.y)} r="4" />
          {tp.showLabel && (
            <text x={px(tp.x) + (tp.x >= 0 ? 8 : -8)} y={py(tp.y) + (tp.y >= 0 ? -6 : 14)} text-anchor={tp.x >= 0 ? 'start' : 'end'}>{tp.p}</text>
          )}
        </g>
      ))}
      {wrong && wrong.pair === pl.j && (
        <g class="rope-wrong">
          <line x1={cx} y1={cy} x2={px(wrong.x)} y2={py(wrong.y)} marker-end={`url(#${id}-w)`} />
          <text x={px(wrong.x) + (wrong.x >= 0 ? 8 : -8)} y={py(wrong.y) + 16} text-anchor={wrong.x >= 0 ? 'start' : 'end'}>{wrong.label}</text>
        </g>
      )}
      <line class="rope-vec" x1={cx} y1={cy} x2={px(pl.cur.x)} y2={py(pl.cur.y)} marker-end={`url(#${id}-a)`} />
      <text class="viz-index" x={cx} y={cy + R + 30} text-anchor="middle">θ = {fmt(pl.cur.theta)} 弧度</text>
      <text class="rope-coord" x={cx} y={cy + R + 50} text-anchor="middle">({fmt(pl.cur.x)}, {fmt(pl.cur.y)})</text>
    </g>
  ))}
</svg>

<style>
  .rope-circle {
    fill: none;
    stroke: var(--viz-cell-line);
    stroke-dasharray: 3 4;
  }
  .rope-arc {
    fill: none;
    stroke: var(--viz-muted);
    stroke-width: 1.2;
  }
  .rope-vec {
    stroke: var(--viz-accent);
    stroke-width: 2.4;
  }
  .rope-head {
    fill: var(--viz-accent);
  }
  .rope-head-warn {
    fill: var(--viz-warn);
  }
  .rope-trail circle {
    fill: var(--viz-cell);
    stroke: var(--viz-muted);
    stroke-width: 1.2;
  }
  svg.viz .rope-trail text {
    fill: var(--viz-muted);
    font-size: 12px;
  }
  .rope-wrong line {
    stroke: var(--viz-warn);
    stroke-width: 2;
    stroke-dasharray: 5 3;
  }
  svg.viz .rope-wrong text {
    fill: var(--viz-warn);
    font-size: 12px;
  }
  svg.viz .rope-coord {
    font-family: var(--sl-font-mono);
    font-size: 13px;
  }
</style>
