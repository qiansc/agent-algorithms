---
// 二维向量图：从原点画出若干箭头。颜色只用 viz.css 里的类。
import { toneClass, uid, type Tone } from '~/components/viz/shared';

interface Vec {
  x: number;
  y: number;
  label: string;
  tone?: Tone;
  dx?: number; // 标签相对箭头末端的偏移（像素）
  dy?: number;
}
interface Props {
  vectors: Vec[];
  points?: Vec[]; // 画成小圆点的向量，例如零向量
  xRange: [number, number];
  yRange: [number, number];
  scale?: number;
  ariaLabel?: string;
}

const { vectors, points = [], xRange, yRange, scale = 60, ariaLabel } = Astro.props;
const pad = 28;
const width = (xRange[1] - xRange[0]) * scale + pad * 2;
const height = (yRange[1] - yRange[0]) * scale + pad * 2;
const px = (x: number) => pad + (x - xRange[0]) * scale;
const py = (y: number) => pad + (yRange[1] - y) * scale;
const id = uid('vp');
const tones = [...new Set(vectors.map((v) => v.tone ?? 'default'))];
const ticks: number[] = [];
for (let t = Math.ceil(xRange[0]); t <= Math.floor(xRange[1]); t++) if (t !== 0) ticks.push(t);
---

<svg class="viz" viewBox={`0 0 ${width} ${height}`} width={width} height={height} role="img" aria-label={ariaLabel ?? '向量图'}>
  <defs>
    {tones.map((t) => (
      <marker id={`${id}-${t}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path class={`viz-arrowhead ${toneClass(t)}`} d="M 0 0 L 10 5 L 0 10 z" />
      </marker>
    ))}
  </defs>
  <line class="viz-axis" x1={px(xRange[0])} x2={px(xRange[1])} y1={py(0)} y2={py(0)} />
  <line class="viz-axis" x1={px(0)} x2={px(0)} y1={py(yRange[0])} y2={py(yRange[1])} />
  {ticks.map((t) => (
    <text class="viz-index" x={px(t)} y={py(0) + 16} text-anchor="middle">{t}</text>
  ))}
  {vectors.map((v) => (
    <path class={`viz-edge ${toneClass(v.tone)}`} d={`M ${px(0)} ${py(0)} L ${px(v.x)} ${py(v.y)}`} marker-end={`url(#${id}-${v.tone ?? 'default'})`} />
  ))}
  {points.map((p) => (
    <circle class="viz-axis" cx={px(p.x)} cy={py(p.y)} r="4" style="fill: none; stroke-width: 1.6" />
  ))}
  {[...vectors, ...points].map((v) => (
    <g class={`viz-edge-label ${toneClass(v.tone)}`}>
      <text x={px(v.x) + (v.dx ?? 0)} y={py(v.y) + (v.dy ?? -10)} text-anchor="middle" style={`font-size: 13px`}>{v.label}</text>
    </g>
  ))}
</svg>
